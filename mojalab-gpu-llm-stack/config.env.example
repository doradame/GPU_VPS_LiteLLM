# mojalab-gpu-llm-stack configuration
# Generated by scripts/00-preflight.sh. Safe to edit by hand.
# All paths and secrets used by subsequent scripts live here.

# --- volume / mount ---
DATA_DEVICE=/dev/sdb           # raw block device for the encrypted data volume
DATA_MOUNT=/srv/llm            # mountpoint for the unlocked volume
LUKS_NAME=llm_crypt            # mapper name (/dev/mapper/${LUKS_NAME})
LUKS_KEYFILE=/root/llm.key     # root-owned keyfile for automatic unlock

# --- public endpoint ---
DOMAIN=llm.example.com
ACME_EMAIL=admin@example.com
# Space-separated list of IPs / CIDRs allowed to reach LiteLLM through Caddy.
ALLOWED_IPS="1.2.3.4 5.6.7.8/32"

# --- engines (yes/no) ---
ENABLE_OLLAMA=yes
ENABLE_VLLM=no

# --- ollama ---
OLLAMA_IMAGE_TAG=0.32.6             # CHECK https://github.com/ollama/ollama/releases
OLLAMA_MODELS_PULL="gemma4:31b"     # space-separated tags; pulled by 06-pull-models.sh
OLLAMA_KEEP_ALIVE=24h
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1

# --- vllm ---
# One vLLM process serves ONE model. A second model needs the vllm2 block
# below. GPU_MEM_UTIL is a cap on TOTAL GPU memory INCLUDING other processes,
# not a private share: on a shared GPU the second instance needs a CUMULATIVE
# cap (first fraction + its own share, e.g. 0.55 and 0.90), and the compose
# file starts vllm2 only after vllm is healthy for exactly this reason.
# EXTRA_ARGS is appended verbatim to `vllm serve` — any flag goes there,
# e.g. "--max-num-seqs 24 --enable-prefix-caching --guided-decoding-backend xgrammar"
VLLM_IMAGE_TAG=v0.8.5                # CHECK https://github.com/vllm-project/vllm/releases
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_SERVED_NAME=qwen2.5-7b
VLLM_GPU_MEM_UTIL=0.85               # lower this when sharing the GPU (e.g. 0.55)
VLLM_MAX_MODEL_LEN=8192
VLLM_EXTRA_ARGS=""
HF_TOKEN=                            # optional, only for gated models

# --- vllm2 (optional second vLLM model, extra container) ---
# Example two-model setup on one 48GB GPU (teacher/critic):
#   VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ                        VLLM_SERVED_NAME=teacher  VLLM_GPU_MEM_UTIL=0.55
#   VLLM2_MODEL=hugging-quants/Meta-Llama-3.1-8B-Instruct-AWQ-INT4  VLLM2_SERVED_NAME=critic  VLLM2_GPU_MEM_UTIL=0.35
# NOTE: the meaning of GPU_MEM_UTIL for the SECOND instance depends on the
# vLLM version (see docs/guide.md): old engines (v0.8.x) want a CUMULATIVE
# cap (0.55+0.35 -> 0.90); new engines (>= ~0.19) want the instance's OWN
# share (0.35) checked against free memory. The startup error tells you
# which one you have.
ENABLE_VLLM2=no
VLLM2_MODEL=
VLLM2_SERVED_NAME=
VLLM2_GPU_MEM_UTIL=0.35
VLLM2_MAX_MODEL_LEN=8192
VLLM2_EXTRA_ARGS=""

# --- litellm ---
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.83.14-stable.patch.3
LITELLM_MASTER_KEY=                  # generated by 05 if empty (sk-<hex>)
POSTGRES_PASSWORD=                   # generated by 05 if empty

# --- nvidia ---
NVIDIA_DRIVER_PKG=nvidia-driver-580-server   # adjust to your GPU; `ubuntu-drivers devices`
