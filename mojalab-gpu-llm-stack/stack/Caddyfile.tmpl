# Caddyfile — generated by scripts/05-stack-config.sh.
# Environment variables (DOMAIN, ACME_EMAIL, ALLOWED_IPS) are interpolated
# by Caddy itself at container startup via {$VAR} syntax.

{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    @allowed {
        client_ip {$ALLOWED_IPS}
    }

    handle @allowed {
        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "strict-origin-when-cross-origin"
        }

        reverse_proxy litellm:4000 {
            flush_interval -1
            transport http {
                response_header_timeout 10m
                read_timeout 10m
            }
        }
    }

    handle {
        respond "Forbidden" 403
    }

    log {
        output stdout
        format json
    }
}
