# docker-compose.yml — generated by scripts/05-stack-config.sh.
# Compose profiles are driven by COMPOSE_PROFILES in .env.

services:
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    environment:
      DOMAIN: ${DOMAIN}
      ACME_EMAIL: ${ACME_EMAIL}
      ALLOWED_IPS: ${ALLOWED_IPS}
    volumes:
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    healthcheck:
      # Caddy's admin API (localhost:2019) is enabled by default.
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:2019/config/"]
      interval: 30s
      timeout: 5s
      retries: 5
    depends_on:
      litellm:
        condition: service_healthy

  db:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_USER: litellm
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: litellm
    volumes:
      - ./pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U litellm"]
      interval: 5s
      timeout: 5s
      retries: 10

  litellm:
    # Derived image: base LITELLM_IMAGE + Pillow (required by image/vision
    # handling code paths in LiteLLM, otherwise some requests fail).
    image: mojalab/litellm-pillow:local
    pull_policy: build
    build:
      dockerfile_inline: |
        FROM ${LITELLM_IMAGE}
        USER root
        # LiteLLM image ships a venv at /app/.venv without pip (built with uv).
        # Bootstrap pip via ensurepip, fall back to uv if present.
        RUN set -eux; \
            if command -v uv >/dev/null 2>&1; then \
                uv pip install --no-cache-dir --python /app/.venv/bin/python Pillow; \
            else \
                python -m ensurepip --upgrade && \
                python -m pip install --no-cache-dir Pillow; \
            fi
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    expose:
      - "4000"
    environment:
      LITELLM_MASTER_KEY: ${LITELLM_MASTER_KEY}
      DATABASE_URL: ${DATABASE_URL}
    volumes:
      - ./litellm-config.yaml:/app/config.yaml:ro
    command: ["--config", "/app/config.yaml", "--port", "4000", "--host", "0.0.0.0"]
    healthcheck:
      # python (not curl) is what the LiteLLM image reliably ships.
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:4000/health/liveliness', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s

  ollama:
    profiles: ["ollama"]
    image: ollama/ollama:${OLLAMA_IMAGE_TAG}
    restart: unless-stopped
    expose:
      - "11434"
    environment:
      OLLAMA_KEEP_ALIVE: ${OLLAMA_KEEP_ALIVE}
      OLLAMA_FLASH_ATTENTION: "1"
      OLLAMA_NUM_PARALLEL: ${OLLAMA_NUM_PARALLEL}
      OLLAMA_MAX_LOADED_MODELS: ${OLLAMA_MAX_LOADED_MODELS}
    volumes:
      - ../ollama:/root/.ollama
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 30s
      timeout: 10s
      retries: 5
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]

  # One vLLM process serves one model; vllm2 below is the optional second
  # model. Shell-form command so ${VLLM_EXTRA_ARGS} can carry any extra flags.
  vllm:
    profiles: ["vllm"]
    image: vllm/vllm-openai:${VLLM_IMAGE_TAG}
    restart: unless-stopped
    expose:
      - "8000"
    ipc: host
    shm_size: "8gb"
    environment:
      HF_TOKEN: ${HF_TOKEN}
      HUGGING_FACE_HUB_TOKEN: ${HF_TOKEN}
    volumes:
      - ../vllm/hf-cache:/root/.cache/huggingface
    entrypoint: ["/bin/sh", "-c"]
    command:
      - >-
        exec vllm serve '${VLLM_MODEL}'
        --served-model-name '${VLLM_SERVED_NAME}'
        --gpu-memory-utilization '${VLLM_GPU_MEM_UTIL}'
        --max-model-len '${VLLM_MAX_MODEL_LEN}'
        --host 0.0.0.0 --port 8000
        ${VLLM_EXTRA_ARGS}
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 10
      # First start can take minutes: model download + weight loading.
      start_period: 600s
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]

  vllm2:
    profiles: ["vllm2"]
    image: vllm/vllm-openai:${VLLM_IMAGE_TAG}
    restart: unless-stopped
    # vLLM's --gpu-memory-utilization is a cap on TOTAL GPU memory including
    # other processes, so on a shared GPU the second instance must (a) start
    # only after the first has claimed its memory and (b) use a CUMULATIVE
    # cap (first's fraction + its own share, e.g. 0.55 + 0.35 -> 0.90).
    depends_on:
      vllm:
        condition: service_healthy
        required: false
    expose:
      - "8000"
    ipc: host
    shm_size: "8gb"
    environment:
      HF_TOKEN: ${HF_TOKEN}
      HUGGING_FACE_HUB_TOKEN: ${HF_TOKEN}
    volumes:
      - ../vllm/hf-cache:/root/.cache/huggingface
    entrypoint: ["/bin/sh", "-c"]
    command:
      - >-
        exec vllm serve '${VLLM2_MODEL}'
        --served-model-name '${VLLM2_SERVED_NAME}'
        --gpu-memory-utilization '${VLLM2_GPU_MEM_UTIL}'
        --max-model-len '${VLLM2_MAX_MODEL_LEN}'
        --host 0.0.0.0 --port 8000
        ${VLLM2_EXTRA_ARGS}
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 600s
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]

volumes:
  caddy_data:
  caddy_config:
